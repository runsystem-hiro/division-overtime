DIVISION_OVERTIME_ENV=production
KINGOFTIME_TOKEN=replace_me
KOT_SYNC_DIVISION_CODES=100,200,300
SLACK_BOT_TOKEN=xoxb-replace_me

# Web administration foundation
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_LOG_LEVEL=INFO

# Web administrator authentication
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD_HASH=replace_with_argon2_hash
# Optional read-only account. Set both values or leave both unset.
WEB_VIEWER_USERNAME=viewer
WEB_VIEWER_PASSWORD_HASH=replace_with_argon2_hash
WEB_SESSION_SECRET=replace_with_at_least_32_random_characters
WEB_SESSION_COOKIE_NAME=division_overtime_session
WEB_SESSION_COOKIE_SECURE=false
WEB_SESSION_MAX_AGE_SECONDS=28800
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_WINDOW_SECONDS=900
WEB_LOGIN_LOCKOUT_SECONDS=900

# Local frontend only: show read-only notification history sample data.
# Effective only while running Vite in development mode; ignored by production builds.
# VITE_NOTIFICATION_HISTORY_MOCK=true

# Optional Cloudflare Access authentication for the public Tunnel route.
# Keep disabled for local-only environments. Do not commit real team domains or audience IDs.
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
CLOUDFLARE_ACCESS_LOGOUT_URL=/cdn-cgi/access/logout
ADMIN_ELEVATION_MINUTES=30
